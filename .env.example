# Copy to .env. The CLI loads it automatically.
# Not needed if you've signed in with `ant auth login`.
ANTHROPIC_API_KEY=

# Model request timeout (seconds) and retries. Worst case before a run gives up on an
# unresponsive provider is about (retries + 1) x timeout.
# AGENT_LLM_TIMEOUT=120
# AGENT_LLM_MAX_RETRIES=1

# Secrets referenced by a task's "secrets" map, e.g. "secrets": { "PASSWORD": "PORTAL_PASSWORD" }
# PORTAL_PASSWORD=
